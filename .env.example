# civicDNA — frontend build-time config.
# Copy to `.env.local` (git-ignored) and fill in. Everything VITE_-prefixed is
# INLINED INTO THE PUBLIC BUNDLE — never put a real secret here.

# Cloudflare Worker that owns the Workers AI binding.
# Leave unset/empty to disable the AI read-out entirely: the results screen
# falls back to the deterministic local read-out with no network call.
#   cd worker && npx wrangler deploy   ->  prints the workers.dev URL
VITE_NARRATIVE_URL=

# Optional. Must match the Worker's CIVICDNA_AI_TOKEN secret:
#   cd worker && npx wrangler secret put CIVICDNA_AI_TOKEN
# Public in the bundle, so treat it as rate-limiting friction, not auth.
# Real protection = pin Access-Control-Allow-Origin in worker/index.js.
VITE_NARRATIVE_TOKEN=
